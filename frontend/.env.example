# ============================================================================
# PayMejor Environment Configuration
# ============================================================================
# This file documents all required and optional environment variables.
# Copy this file to .env.local and fill in the values.
# ============================================================================

# ============================================================================
# Network Configuration - Dual Network Support
# ============================================================================

# Default Network (sepolia or mainnet)
# Determines which network is selected by default when the app loads
NEXT_PUBLIC_DEFAULT_NETWORK=sepolia

# ============================================================================
# Starknet Sepolia Testnet Configuration
# ============================================================================

# Sepolia RPC URL (REQUIRED)
# Public RPC endpoint for Starknet Sepolia testnet
# Options:
# - https://starknet-sepolia.public.blastapi.io/rpc/v0_7 (Blast API - Free)
# - https://starknet-sepolia.infura.io/v3/YOUR_API_KEY (Infura)
# - https://starknet-sepolia.g.alchemy.com/v2/YOUR_API_KEY (Alchemy)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_7

# Sepolia Contract Addresses (OPTIONAL - Required for full functionality)
# Vesu Lending Pool address on Sepolia (Re7 USDC Core pool)
# Note: Vesu V2 may not be deployed on Sepolia yet - check docs for testnet pools
NEXT_PUBLIC_SEPOLIA_VESU_POOL_ADDRESS=

# Tongo Protocol address on Sepolia (Privacy Layer)
# USDC Tongo instance
NEXT_PUBLIC_SEPOLIA_TONGO_PROTOCOL_ADDRESS=0x2caae365e67921979a4e5c16dd70eaa5776cfc6a9592bcb903d91933aaf2552

# wBTC token address on Sepolia
# Note: wBTC may not be available on Sepolia - use testnet equivalent
NEXT_PUBLIC_SEPOLIA_WBTC_ADDRESS=

# USDC token address on Sepolia
NEXT_PUBLIC_SEPOLIA_USDC_ADDRESS=0x053b40a647cedfca6ca84f542a0fe36736031905a9639a7f19a3c1e66bfd5080

# Organization Factory address on Sepolia (Semaphore Organization Pooling)
NEXT_PUBLIC_SEPOLIA_ORGANIZATION_FACTORY_ADDRESS=

# Semaphore Verifier address on Sepolia (Zero-Knowledge Proof Verification)
NEXT_PUBLIC_SEPOLIA_SEMAPHORE_ADDRESS=

# ============================================================================
# Starknet Mainnet Configuration
# ============================================================================

# Mainnet RPC URL (REQUIRED)
# Public RPC endpoint for Starknet Mainnet
# Options:
# - https://starknet-mainnet.public.blastapi.io/rpc/v0_7 (Blast API - Free)
# - https://starknet-mainnet.infura.io/v3/YOUR_API_KEY (Infura)
# - https://starknet-mainnet.g.alchemy.com/v2/YOUR_API_KEY (Alchemy)
NEXT_PUBLIC_MAINNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_7

# Mainnet Contract Addresses (OPTIONAL - Required for full functionality)
# Vesu Lending Pool address on Mainnet
# Using Re7 xBTC pool (supports wBTC collateral)
NEXT_PUBLIC_MAINNET_VESU_POOL_ADDRESS=0x3a8416bf20d036df5b1cf3447630a2e1cb04685f6b0c3a70ed7fb1473548ecf

# Tongo Protocol address on Mainnet (Privacy Layer)
# wBTC Tongo instance
NEXT_PUBLIC_MAINNET_TONGO_PROTOCOL_ADDRESS=0x6d82c8c467eac77f880a1d5a090e0e0094a557bf67d74b98ba1881200750e27

# wBTC token address on Mainnet
NEXT_PUBLIC_MAINNET_WBTC_ADDRESS=0x03fe2b97c1fd336e750087d68b9b867997fd64a2661ff3ca5a7c771641e8e7ac

# USDC token address on Mainnet (USDC native)
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=0x033068F6539f8e6e6b131e6B2B814e6c34A5224bC66947c47DaB9dFeE93b35fb

# Organization Factory address on Mainnet (Semaphore Organization Pooling)
NEXT_PUBLIC_MAINNET_ORGANIZATION_FACTORY_ADDRESS=

# Semaphore Verifier address on Mainnet (Zero-Knowledge Proof Verification)
NEXT_PUBLIC_MAINNET_SEMAPHORE_ADDRESS=

# AutoSwap Address (DEPRECATED - Using AVNU now)
# https://github.com/BlockheaderWeb3-Community/autoswap-sdk/blob/main/lib/README.md
AUTOSWAPPR_CONTRACT_ADDRESS=0x05582ad635c43b4c14dbfa53cbde0df32266164a0d1b36e5b510e5b34aeb364b

# ============================================================================
# AVNU Paymaster Configuration (Gasless Transactions)
# ============================================================================

# AVNU Paymaster API Key (OPTIONAL - Required for gasless swaps)
# Sign up at: https://portal.avnu.fi
# Create an API key and add credits (STRK) for mainnet
# Sepolia has unlimited free credits for testing
NEXT_PUBLIC_PAYMASTER_API=

# Paymaster URLs (Pre-configured)
NEXT_PUBLIC_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
NEXT_PUBLIC_PAYMASTER_URL_MAINNET=https://starknet.paymaster.avnu.fi

# AVNU API URLs (Pre-configured)
NEXT_PUBLIC_PAYMASTER_API_URL=https://sepolia.api.avnu.fi
NEXT_PUBLIC_PAYMASTER_API_MAINNET_URL=https://starknet.api.avnu.fi


# ============================================================================
# MavaPay Configuration (BTC ↔ NGN On/Off-Ramp)
# ============================================================================

# MavaPay API URLs (Pre-configured)
NEXT_PUBLIC_MAVAPAY_API_URL=https://api.mavapay.co
NEXT_PUBLIC_MAVAPAY_SANDBOX_URL=https://staging.api.mavapay.co

# MavaPay API Keys (REQUIRED for on/off-ramp functionality)
# Production API Key - Get from MavaPay dashboard
MAVAPAY_API_KEY=

# Sandbox API Key - Get from MavaPay dashboard for testing
MAVAPAY_SANDBOX_API_KEY=

# MavaPay Webhook Secrets (REQUIRED for webhook verification)
# Production Webhook Secret
MAVAPAY_WEBHOOK_SECRET=

# Sandbox Webhook Secret
MAVAPAY_SANDBOX_WEBHOOK_SECRET=

# Feature Flag - Enable/Disable MavaPay Ramp
NEXT_PUBLIC_ENABLE_MAVAPAY_RAMP=true

# Environment Selection - Force sandbox or production (optional)
# If not set, automatically uses sandbox in development/sepolia and production in mainnet
# NEXT_PUBLIC_MAVAPAY_USE_SANDBOX=true

# Minimum NGN Amount (in kobo) - Default: 200000 (2000 NGN)
NEXT_PUBLIC_MAVAPAY_MIN_NGN_AMOUNT=200000

# ============================================================================
# External APIs (Optional)
# ============================================================================

# CoinGecko API for exchange rates (used in Exit tab)
# Free tier: 10-50 calls/minute
# No API key required for basic usage
# NEXT_PUBLIC_COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ============================================================================
# Setup Instructions
# ============================================================================
# 
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 
# 2. Fill in the contract addresses for your target network(s)
# 
# 3. (Optional) Set up AVNU Paymaster for gasless transactions:
#    - Sign up at https://portal.avnu.fi
#    - Create an API key
#    - Add credits (STRK) for mainnet (Sepolia is free)
#    - Add your API key to NEXT_PUBLIC_PAYMASTER_API
# 
# 4. For local development (Sepolia):
#    - Use public RPC endpoints (already configured)
#    - Get testnet tokens from faucets
#    - Fill in Sepolia contract addresses
#    - Test gasless swaps with free Sepolia credits
# 
# 5. For production (Mainnet):
#    - Use authenticated RPC endpoints (Infura/Alchemy)
#    - Fill in Mainnet contract addresses
#    - Verify all addresses on Voyager explorer
#    - Fund your Paymaster API key with STRK
# 
# 6. See ENVIRONMENT_SETUP.md for detailed configuration guide
# 
# ============================================================================

# ============================================================================
# Where to Find Contract Addresses
# ============================================================================
# 
# Vesu Protocol:
#   - Docs: https://docs.vesu.xyz/developers/contract-addresses
#   - Look for "Isolated Lending Pools" section
# 
# Tongo Protocol:
#   - Docs: https://docs.tongo.cash
#   - SDK: https://docs.tongo.cash/sdk/quick-start.html
# 
# Token Addresses (wBTC, USDC):
#   - Starknet Token Registry: https://www.starknet.io/ecosystem
#   - Voyager Explorer:
#     - Sepolia: https://sepolia.voyager.online
#     - Mainnet: https://voyager.online
# 
# AutoSwap (DEPRECATED - Using AVNU now):
#   - GitHub: https://github.com/BlockheaderWeb3-Community/autoswap-sdk
#   - Current address: 0x05582ad635c43b4c14dbfa53cbde0df32266164a0d1b36e5b510e5b34aeb364b
# 
# AVNU Paymaster (Gasless Transactions):
#   - Portal: https://portal.avnu.fi
#   - Docs: https://docs.avnu.fi/docs/paymaster/gasfree
#   - Sign up and create API key for gasless swaps
# 
# ============================================================================

# ============================================================================
# Important Notes
# ============================================================================
# 
# 1. RPC URLs are REQUIRED for the application to function
# 2. Contract addresses are OPTIONAL but needed for full functionality
# 3. You can use public RPC endpoints for testing (rate-limited)
# 4. For production, use authenticated RPC endpoints (Infura/Alchemy)
# 5. Network selector in UI allows switching between Sepolia and Mainnet
# 6. Contract addresses differ between Sepolia and Mainnet
# 7. Always verify contract addresses on Voyager before using
# 8. Never commit .env.local to version control
# 9. Test with small amounts on Mainnet first
# 
# ============================================================================
